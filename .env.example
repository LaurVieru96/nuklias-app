# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Get your connection string from https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require

# ===========================================
# SESSION CONFIGURATION
# ===========================================
# Generate a strong random secret with: openssl rand -base64 32
# IMPORTANT: Change this in production!
SESSION_SECRET=your-random-secret-key-change-this-in-production

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Frontend URL for CORS (where your React/Vue app runs)
# Development: http://localhost:5000
# Production: https://nuklias.netlify.app/
CLIENT_URL=http://localhost:5000

# ===========================================
# OPTIONAL: EMAIL CONFIGURATION (if needed)
# ===========================================
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
